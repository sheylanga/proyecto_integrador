        <mxCell id="hdr_chen" value="DERMA-ECOM — MODELO CONCEPTUAL: DIAGRAMA ENTIDAD-RELACIÓN EXTENDIDO (NOTACIÓN CHEN / ELMASRI &amp;amp; NAVATHE)
